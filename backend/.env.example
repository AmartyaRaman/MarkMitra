# Copy to backend/.env and fill in real values:  cp backend/.env.example backend/.env
# Never commit backend/.env.

# docker-compose.prod.yml forces NODE_ENV=production, which makes the backend
# refuse to start with weak/default secrets below.
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────
# DB_HOST is overridden to "postgres" inside Docker Compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=markmitra
DB_USER=postgres
# Generate with:  openssl rand -base64 24
# Note: Postgres only applies this on first start (empty volume). To change it
# later, run ALTER USER inside the DB or recreate the postgres_data volume.
DB_PASSWORD=change-me

# ── Auth ────────────────────────────────────────────────────
# Must be at least 32 random characters in production.
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ── AI ──────────────────────────────────────────────────────
# Get one at https://aistudio.google.com/apikey  (leave as-is for demo mode)
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of exact origins the browser uses (scheme + host, plus
# port only if it's not 80/443). Example for production:
#   ALLOWED_ORIGINS=http://markmitra.example.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
